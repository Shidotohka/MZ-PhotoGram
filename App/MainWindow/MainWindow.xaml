<Window x:Class="Photogrammetry.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Photogrammetry.App"
        Title="摄影测量工作台"
        Width="1440" Height="900"
        MinWidth="1100" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource BgBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="12.5"
        Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- 点表两套列共用同一副皮，样式只写一份 -->
        <Style x:Key="MeasureHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource Panel3Brush}"/>
            <Setter Property="Foreground" Value="{StaticResource MutBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        </Style>

        <Style x:Key="MeasureCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MeasureGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Panel3Brush}"/>
            <Setter Property="RowBackground" Value="{StaticResource PanelBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource Panel2Brush}"/>
            <Setter Property="RowHeight" Value="22"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource MeasureHeaderStyle}"/>
            <Setter Property="CellStyle" Value="{StaticResource MeasureCellStyle}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="198"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- ============ 标题栏 ============ -->
        <Border Grid.Row="0" Background="{StaticResource TitleGradientBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False" Margin="14,0">
                <Border DockPanel.Dock="Left" Width="24" Height="24" CornerRadius="6"
                        Background="{StaticResource AccentBrush}" VerticalAlignment="Center">
                    <TextBlock Text="P" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock DockPanel.Dock="Left" Text="摄影测量工作台" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                <TextBlock DockPanel.Dock="Left" Text="解析摄影测量 · v0.1" FontSize="12"
                           Foreground="{StaticResource DimBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>

                <Button DockPanel.Dock="Left" Content="文件 ▾" Style="{StaticResource ToolBtn}"
                        VerticalAlignment="Center" Margin="14,0,0,0" Click="FileMenu_Click">
                    <Button.ContextMenu>
                        <ContextMenu Style="{StaticResource MenuPopup}">
                            <MenuItem Header="新建工程" InputGestureText="Ctrl+N" Click="NewProject_Click"/>
                            <MenuItem Header="打开工程…" InputGestureText="Ctrl+O" Click="OpenProject_Click"/>
                            <MenuItem Header="保存工程" InputGestureText="Ctrl+S" Click="SaveProject_Click"/>
                            <MenuItem Header="另存为…" InputGestureText="Ctrl+Shift+S" Click="SaveProjectAs_Click"/>
                            <Separator/>
                            <MenuItem Header="退出" Click="Exit_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <Button DockPanel.Dock="Left" Content="载入 ▾" Style="{StaticResource ToolBtn}"
                        VerticalAlignment="Center" Click="LoadMenu_Click">
                    <Button.ContextMenu>
                        <ContextMenu Style="{StaticResource MenuPopup}">
                            <MenuItem Header="影像…" InputGestureText="Ctrl+I" Click="AddImage_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <!-- 作业方法：决定下面模块栏显示哪一串步骤 -->
                <TextBlock DockPanel.Dock="Left" Text="方法" FontSize="12"
                           Foreground="{StaticResource DimBrush}" VerticalAlignment="Center"
                           Margin="16,0,6,0"/>
                <ComboBox x:Name="MethodBox" DockPanel.Dock="Left" Width="182"
                          Style="{StaticResource MethodCombo}" VerticalAlignment="Center"
                          SelectionChanged="Method_Changed"/>

                <Button DockPanel.Dock="Right" Content="帮助" Style="{StaticResource ToolBtn}" VerticalAlignment="Center"/>

                <Border DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                        Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="10,4">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource OkBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="项目" Foreground="{StaticResource MutBrush}" FontSize="12" Margin="7,0,0,0"/>
                        <TextBlock x:Name="ProjectNameText" Text="未命名工程" FontSize="12" Margin="5,0,0,0"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- ============ 模块栏 ============ -->
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False" Margin="12,0">
                <StackPanel x:Name="ModuleBar" DockPanel.Dock="Left" Orientation="Horizontal">
                    <RadioButton Content="内定向" GroupName="Module" Style="{StaticResource ModuleTab}"
                                 Checked="Module_Checked"/>
                    <RadioButton Content="后方交会" GroupName="Module" Style="{StaticResource ModuleTab}"
                                 Checked="Module_Checked"/>
                    <RadioButton Content="前方交会" GroupName="Module" Style="{StaticResource ModuleTab}"
                                 Checked="Module_Checked"/>
                    <RadioButton Content="相对定向" GroupName="Module" Style="{StaticResource ModuleTab}"
                                 Checked="Module_Checked"/>
                    <RadioButton Content="模型交会" GroupName="Module" Style="{StaticResource ModuleTab}"
                                 Checked="Module_Checked"/>
                    <RadioButton Content="绝对定向" GroupName="Module" Style="{StaticResource ModuleTab}"
                                 Checked="Module_Checked"/>
                    <RadioButton Content="光束平差" GroupName="Module" Style="{StaticResource ModuleTab}"
                                 Checked="Module_Checked"/>
                    <RadioButton Content="报告" GroupName="Module" Style="{StaticResource ModuleTab}"
                                 Checked="Module_Checked"/>
                </StackPanel>
                <TextBlock x:Name="ModuleHint" DockPanel.Dock="Right" VerticalAlignment="Center"
                           FontSize="12" Foreground="{StaticResource DimBrush}" Text=""/>
            </DockPanel>
        </Border>

        <!-- ============ 主体 ============ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="268"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="372"/>
            </Grid.ColumnDefinitions>

            <!-- 左：数据树 -->
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Height="36" Padding="12,0"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="项目数据" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{StaticResource DimBrush}"/>
                    </Border>

                    <TreeView x:Name="DataTree" Background="Transparent" BorderThickness="0"
                              Padding="4,6" Foreground="{StaticResource TextBrush}"
                              SelectedItemChanged="DataTree_SelectedItemChanged"
                              PreviewMouseLeftButtonDown="DataTree_PreviewMouseLeftButtonDown"
                              PreviewMouseRightButtonDown="DataTree_PreviewMouseRightButtonDown"
                              PreviewMouseMove="DataTree_PreviewMouseMove"
                              MouseDoubleClick="DataTree_MouseDoubleClick">
                        <TreeView.ContextMenu>
                            <ContextMenu Style="{StaticResource MenuPopup}">
                                <MenuItem Header="载入到工作区" Click="CtxLoad_Click"/>
                                <MenuItem Header="从工作区移除" Click="CtxUnload_Click"/>
                                <Separator/>
                                <MenuItem Header="从工程移除…" Click="CtxRemove_Click"/>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded}"/>
                                <Setter Property="Padding" Value="1"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <DockPanel LastChildFill="True" Margin="0,1">
                                    <TextBlock Text="{Binding Icon}" Width="15" FontSize="11"
                                               Foreground="{StaticResource DimBrush}"
                                               VerticalAlignment="Center"/>
                                    <Border DockPanel.Dock="Right" CornerRadius="3" Padding="5,0"
                                            Background="{StaticResource Panel3Brush}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Badge}" FontSize="10"
                                                   FontFamily="Consolas"
                                                   Foreground="{Binding BadgeBrush}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Title}" FontSize="12"
                                               Foreground="{StaticResource TextBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <!-- 中：影像工作区 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                        <Button Content="−" Click="ZoomOut_Click" Style="{StaticResource ToolBtn}"/>
                        <TextBlock x:Name="ZoomLabel" Text="100%" Width="52" FontSize="12"
                                   FontFamily="Consolas" Foreground="{StaticResource MutBrush}"
                                   TextAlignment="Center" VerticalAlignment="Center"/>
                        <Button Content="＋" Click="ZoomIn_Click" Style="{StaticResource ToolBtn}"/>
                        <Button Content="◱ 适配" Click="Fit_Click" Style="{StaticResource ToolBtn}"/>
                        <Border Width="1" Height="18" Margin="6,0"
                                Background="{StaticResource Line2Brush}"/>
                        <StackPanel x:Name="PointTools" Orientation="Horizontal">
                            <Button Content="⌖ 取点" Style="{StaticResource ToolBtn}"/>
                            <Button Content="✕ 删除点" Click="DeletePoint_Click" Style="{StaticResource ToolBtn}"/>
                            <Button Content="⇹ 同名连线" Style="{StaticResource ToolBtn}"/>
                        </StackPanel>
                        <TextBlock VerticalAlignment="Center" Margin="14,0,0,0" FontSize="11"
                                   Foreground="{StaticResource DimBrush}"
                                   Text="中键拖动 平移 · 滚轮 缩放 · 左键 取点/选中 · 右键 删除未绑定点"/>
                    </StackPanel>
                </Border>

                <local:ImageWorkspace x:Name="Workspace" Grid.Row="1"/>
            </Grid>

            <!-- 右：检查器 -->
            <Border Grid.Column="2" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Height="38" Padding="12,0"
                            Background="{StaticResource Panel2Brush}"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                        <DockPanel LastChildFill="False">
                            <TextBlock x:Name="InspectorTitle" Text="相对定向"
                                       VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <Border DockPanel.Dock="Right" VerticalAlignment="Center" CornerRadius="3"
                                    Background="{StaticResource Panel3Brush}" Padding="6,1">
                                <TextBlock Text="Task" FontSize="10.5" FontFamily="Consolas"
                                           Foreground="{StaticResource DimBrush}"/>
                            </Border>
                        </DockPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                        <StackPanel>
                            <Border Background="{StaticResource Panel2Brush}"
                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                    CornerRadius="7" Padding="11" Margin="0,0,0,9">
                                <StackPanel>
                                    <TextBlock Text="当前影像" FontSize="12"
                                               Foreground="{StaticResource MutBrush}"/>
                                    <TextBlock x:Name="ImageInfoText" Text="未载入" FontSize="11.5"
                                               Foreground="{StaticResource DimBrush}"
                                               Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource Panel2Brush}"
                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                    CornerRadius="7" Padding="11" Margin="0,0,0,9">
                                <StackPanel>
                                    <TextBlock Text="选定像点" FontSize="12"
                                               Foreground="{StaticResource MutBrush}"/>
                                    <TextBlock x:Name="PointInfoText" Text="未选择" FontSize="11.5"
                                               FontFamily="Consolas" Foreground="{StaticResource DimBrush}"
                                               Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource Panel2Brush}"
                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                    CornerRadius="7" Padding="11">
                                <StackPanel>
                                    <TextBlock Text="输入检查" FontSize="12"
                                               Foreground="{StaticResource MutBrush}"/>
                                    <TextBlock x:Name="CheckText" Text="未载入影像"
                                               FontSize="11.5" Foreground="{StaticResource DimBrush}"
                                               Margin="0,8,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource Panel2Brush}"
                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                    CornerRadius="7" Padding="11" Margin="0,9,0,0">
                                <StackPanel>
                                    <TextBlock Text="任务参数" FontSize="12"
                                               Foreground="{StaticResource MutBrush}"/>

                                    <!-- 内定向：两种方式，二选一 -->
                                    <StackPanel x:Name="InteriorPanel" Visibility="Collapsed" Margin="0,8,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="ModeParametric" Content="参数式"
                                                         GroupName="InteriorMode" FontSize="11.5"
                                                         Margin="0,0,16,0" Checked="InteriorMode_Checked"/>
                                            <RadioButton x:Name="ModeFiducial" Content="框标仿射"
                                                         GroupName="InteriorMode" FontSize="11.5"
                                                         IsChecked="True" Checked="InteriorMode_Checked"/>
                                        </StackPanel>
                                        <TextBlock x:Name="InteriorModeHint" FontSize="10.5"
                                                   Foreground="{StaticResource DimBrush}"
                                                   TextWrapping="Wrap" Margin="0,5,0,0"/>

                                        <!-- 方式一：参数式 -->
                                        <StackPanel x:Name="ParametricPanel" Visibility="Collapsed" Margin="0,8,0,0">
                                            <DockPanel Margin="0,2">
                                                <TextBlock Text="f (mm)" Width="66" FontSize="11.5"
                                                           Foreground="{StaticResource DimBrush}"
                                                           VerticalAlignment="Center"/>
                                                <TextBox x:Name="ParamF" FontSize="11.5" FontFamily="Consolas"
                                                         Padding="3,1"/>
                                            </DockPanel>
                                            <DockPanel Margin="0,2">
                                                <TextBlock Text="x0 (mm)" Width="66" FontSize="11.5"
                                                           Foreground="{StaticResource DimBrush}"
                                                           VerticalAlignment="Center"/>
                                                <TextBox x:Name="ParamX0" FontSize="11.5" FontFamily="Consolas"
                                                         Padding="3,1"/>
                                            </DockPanel>
                                            <DockPanel Margin="0,2">
                                                <TextBlock Text="y0 (mm)" Width="66" FontSize="11.5"
                                                           Foreground="{StaticResource DimBrush}"
                                                           VerticalAlignment="Center"/>
                                                <TextBox x:Name="ParamY0" FontSize="11.5" FontFamily="Consolas"
                                                         Padding="3,1"/>
                                            </DockPanel>
                                            <DockPanel Margin="0,2">
                                                <TextBlock Text="δ (mm/px)" Width="66" FontSize="11.5"
                                                           Foreground="{StaticResource DimBrush}"
                                                           VerticalAlignment="Center"/>
                                                <TextBox x:Name="ParamPixel" FontSize="11.5" FontFamily="Consolas"
                                                         Padding="3,1"/>
                                            </DockPanel>
                                            <Button Content="应用到当前影像" Click="ApplyParametric_Click"
                                                    Style="{StaticResource ToolBtn}"
                                                    HorizontalAlignment="Stretch" Margin="0,6,0,0"/>
                                        </StackPanel>

                                        <!-- 方式二：框标仿射 -->
                                        <StackPanel x:Name="FiducialPanel" Margin="0,8,0,0">
                                            <TextBlock x:Name="CameraInfoText" Text="未载入相机检校文件"
                                                       FontSize="11.5" Foreground="{StaticResource DimBrush}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock FontSize="10.5" Foreground="{StaticResource DimBrush}"
                                                       TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Text="在下方「点表」里选一行，再左键在影像上点该框标。"/>
                                            <UniformGrid Columns="2" Margin="0,6,0,0">
                                                <Button Content="载入相机检校文件…" Click="LoadCamera_Click"
                                                        Style="{StaticResource ToolBtn}"
                                                        HorizontalAlignment="Stretch" Margin="0,0,3,4"/>
                                                <Button Content="编辑框标…" Click="EditFiducials_Click"
                                                        Style="{StaticResource ToolBtn}"
                                                        HorizontalAlignment="Stretch" Margin="3,0,0,4"/>
                                            </UniformGrid>
                                            <UniformGrid Columns="2">
                                                <Button Content="解算内定向" Click="SolveFiducial_Click"
                                                        Style="{StaticResource ToolBtn}"
                                                        HorizontalAlignment="Stretch" Margin="0,0,3,0"/>
                                                <Button Content="清空本影像框标" Click="ClearFiducials_Click"
                                                        Style="{StaticResource ToolBtn}"
                                                        HorizontalAlignment="Stretch" Margin="3,0,0,0"/>
                                            </UniformGrid>
                                            <Border Background="{StaticResource PanelBrush}"
                                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                                    CornerRadius="5" Padding="8" Margin="0,6,0,0">
                                                <TextBlock x:Name="FiducialResultText" Text="尚未解算"
                                                           FontSize="11" FontFamily="Consolas"
                                                           Foreground="{StaticResource DimBrush}"
                                                           TextWrapping="Wrap"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- 后方交会 -->
                                    <StackPanel x:Name="ResectionPanel" Visibility="Collapsed" Margin="0,8,0,0">
                                        <UniformGrid Columns="2" Margin="0,0,0,4">
                                            <Button Content="载入控制点文件…" Click="LoadControlPoints_Click"
                                                    Style="{StaticResource ToolBtn}"
                                                    HorizontalAlignment="Stretch" Margin="0,0,3,0"/>
                                            <Button Content="载入控制点图像…" Click="LoadZoomImages_Click"
                                                    Style="{StaticResource ToolBtn}"
                                                    HorizontalAlignment="Stretch" Margin="3,0,0,0"/>
                                        </UniformGrid>

                                        <!-- 载入的控制点放大影像列表：点一行就在左窗看它 -->
                                        <Border Background="{StaticResource PanelBrush}"
                                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                                CornerRadius="5" Padding="4" MaxHeight="128">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <StackPanel x:Name="ZoomImageListPanel"/>
                                            </ScrollViewer>
                                        </Border>

                                        <TextBlock x:Name="ResectionHint" FontSize="11" Margin="0,6,0,0"
                                                   Foreground="{StaticResource DimBrush}"
                                                   TextWrapping="Wrap"/>
                                        <Border Background="{StaticResource PanelBrush}"
                                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                                CornerRadius="5" Padding="8" Margin="0,6,0,0">
                                            <TextBlock x:Name="ResectionEquationText" FontSize="10.5"
                                                       FontFamily="Consolas"
                                                       Foreground="{StaticResource DimBrush}"
                                                       TextWrapping="Wrap"/>
                                        </Border>
                                        <Button Content="解算后方交会" Click="SolveResection_Click"
                                                Style="{StaticResource ToolBtn}"
                                                HorizontalAlignment="Stretch" Margin="0,6,0,0"/>
                                        <Border Background="{StaticResource PanelBrush}"
                                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                                CornerRadius="5" Padding="8" Margin="0,6,0,0">
                                            <TextBlock x:Name="ResectionResultText" Text="尚未解算"
                                                       FontSize="11" FontFamily="Consolas"
                                                       Foreground="{StaticResource DimBrush}"
                                                       TextWrapping="Wrap"/>
                                        </Border>
                                        <Button Content="清空本影像刺点" Click="ClearGcpPoints_Click"
                                                Style="{StaticResource ToolBtn}"
                                                HorizontalAlignment="Stretch" Margin="0,6,0,0"/>
                                    </StackPanel>

                                    <!-- 前方交会 -->
                                    <StackPanel x:Name="IntersectionPanel" Visibility="Collapsed" Margin="0,8,0,0">
                                        <TextBlock x:Name="IntersectionHint" FontSize="11"
                                                   Foreground="{StaticResource DimBrush}"
                                                   TextWrapping="Wrap"/>

                                        <Border Background="{StaticResource PanelBrush}"
                                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                                CornerRadius="5" Padding="8" Margin="0,6,0,0">
                                            <TextBlock x:Name="IntersectionPairText" Text="左片 —　右片 —"
                                                       FontSize="11" FontFamily="Consolas"
                                                       Foreground="{StaticResource DimBrush}"
                                                       TextWrapping="Wrap"/>
                                        </Border>

                                        <Button x:Name="IntersectionSolveButton" Content="解算交会点"
                                                Click="SolveIntersection_Click"
                                                Style="{StaticResource ToolBtn}"
                                                HorizontalAlignment="Stretch" Margin="0,6,0,0"/>

                                        <Border Background="{StaticResource PanelBrush}"
                                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                                CornerRadius="5" Padding="8" Margin="0,6,0,0">
                                            <TextBlock x:Name="IntersectionResultText" Text="尚未解算"
                                                       FontSize="11" FontFamily="Consolas"
                                                       Foreground="{StaticResource DimBrush}"
                                                       TextWrapping="Wrap"/>
                                        </Border>

                                        <Button Content="清空配对" Click="ClearIntersectionPair_Click"
                                                Style="{StaticResource ToolBtn}"
                                                HorizontalAlignment="Stretch" Margin="0,6,0,0"/>
                                    </StackPanel>

                                    <!-- 其他模块的占位 -->
                                    <StackPanel x:Name="GenericTaskPanel" Margin="0,8,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="迭代限差" FontSize="11.5"
                                                       Foreground="{StaticResource DimBrush}"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="0.0001 mm"
                                                       FontSize="11.5" FontFamily="Consolas"/>
                                            <TextBlock Grid.Row="1" Text="最大迭代" FontSize="11.5"
                                                       Foreground="{StaticResource DimBrush}" Margin="0,5,0,0"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="20"
                                                       FontSize="11.5" FontFamily="Consolas" Margin="0,5,0,0"/>
                                            <TextBlock Grid.Row="2" Text="初值" FontSize="11.5"
                                                       Foreground="{StaticResource DimBrush}" Margin="0,5,0,0"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="自动估计"
                                                       FontSize="11.5" Margin="0,5,0,0"/>
                                        </Grid>
                                        <TextBlock Text="（该模块参数待接入）" FontSize="11"
                                                   Foreground="{StaticResource DimBrush}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ============ 底部面板 ============ -->
        <Border Grid.Row="3" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Height="34"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                    <DockPanel LastChildFill="False" Margin="8,0">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <RadioButton x:Name="BottomTabsMeasure" Content="点表" GroupName="Bottom" Tag="meas"
                                         Style="{StaticResource BottomTab}" Checked="BottomTab_Checked"/>
                            <RadioButton Content="诊断" GroupName="Bottom" Tag="diag"
                                         Style="{StaticResource BottomTab}" IsChecked="True"
                                         Checked="BottomTab_Checked"/>
                            <RadioButton x:Name="ResTab" Content="结果残差" GroupName="Bottom" Tag="res"
                                         Style="{StaticResource BottomTab}" Checked="BottomTab_Checked"/>
                            <RadioButton Content="日志" GroupName="Bottom" Tag="log"
                                         Style="{StaticResource BottomTab}" Checked="BottomTab_Checked"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{StaticResource DimBrush}"
                                   Text="校验体系：数据完整性 · 几何条件 · 计算过程"/>
                    </DockPanel>
                </Border>

                <Grid Margin="14,10">
                    <!-- 点表：当前任务要用到的点。内定向列框标，后方交会列控制点 -->
                    <Grid x:Name="MeasurePanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
                            <TextBlock x:Name="MeasureSummary" DockPanel.Dock="Left" FontSize="11.5"
                                       Foreground="{StaticResource MutBrush}" VerticalAlignment="Center"
                                       Text="点表 · 尚未载入"/>
                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11"
                                       Foreground="{StaticResource DimBrush}"
                                       Text="右键一行可删掉那一个点 · 整片清空在各模块的任务参数里"/>
                        </DockPanel>

                        <Grid Grid.Row="1">
                            <!-- 内定向：框标 -->
                            <DataGrid x:Name="FiducialGrid" Style="{StaticResource MeasureGridStyle}"
                                      SelectionChanged="FiducialGrid_SelectionChanged">
                                <DataGrid.ContextMenu>
                                    <ContextMenu Style="{StaticResource MenuPopup}">
                                        <MenuItem Header="删掉这个框标的量测" Click="DeleteSelectedPoint_Click"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="编号" Width="70" Binding="{Binding Id}"/>
                                    <DataGridTextColumn Header="X (mm)" Width="110" Binding="{Binding X}"/>
                                    <DataGridTextColumn Header="Y (mm)" Width="110" Binding="{Binding Y}"/>
                                    <DataGridTextColumn Header="方位" Width="110" Binding="{Binding Direction}"/>
                                    <DataGridTextColumn Header="像元 I" Width="110" Binding="{Binding PixelI}"/>
                                    <DataGridTextColumn Header="像元 J" Width="110" Binding="{Binding PixelJ}"/>
                                    <DataGridTextColumn Header="说明" Width="*" Binding="{Binding Note}"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- 后方交会：控制点 -->
                            <DataGrid x:Name="GcpGrid" Style="{StaticResource MeasureGridStyle}"
                                      Visibility="Collapsed"
                                      SelectionChanged="GcpGrid_SelectionChanged">
                                <DataGrid.ContextMenu>
                                    <ContextMenu Style="{StaticResource MenuPopup}">
                                        <MenuItem Header="设为控制点" Click="GcpSetControl_Click"/>
                                        <MenuItem Header="设为检查点（不参与解算）" Click="GcpSetCheck_Click"/>
                                        <Separator/>
                                        <MenuItem Header="删掉这个控制点的量测" Click="DeleteSelectedPoint_Click"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="点号" Width="80" Binding="{Binding Id}"/>
                                    <DataGridTextColumn Header="X (m)" Width="106" Binding="{Binding X}"/>
                                    <DataGridTextColumn Header="Y (m)" Width="106" Binding="{Binding Y}"/>
                                    <DataGridTextColumn Header="Z (m)" Width="92" Binding="{Binding Z}"/>
                                    <DataGridTextColumn Header="类型" Width="58" Binding="{Binding Type}"/>
                                    <DataGridTextColumn Header="像平面 x (mm)" Width="118" Binding="{Binding Xmm}"/>
                                    <DataGridTextColumn Header="像平面 y (mm)" Width="118" Binding="{Binding Ymm}"/>
                                    <DataGridTextColumn Header="像素" Width="104" Binding="{Binding Pixel}"/>
                                    <DataGridTextColumn Header="残差 (mm)" Width="92" Binding="{Binding Residual}"/>
                                    <DataGridTextColumn Header="说明" Width="*" Binding="{Binding Note}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>

                    <StackPanel x:Name="DiagPanel">
                        <TextBlock x:Name="DiagSummary" Text="诊断 · 尚未打开工程"
                                   FontSize="12" Foreground="{StaticResource MutBrush}" Margin="0,2"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <ScrollViewer x:Name="ResPanel" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="ResPanelText"
                                   FontSize="11.5" FontFamily="Consolas"
                                   Foreground="{StaticResource MutBrush}"
                                   Text="结果残差 · 尚未解算"/>
                    </ScrollViewer>
                    <TextBlock x:Name="LogPanel" Visibility="Collapsed"
                               FontSize="12" FontFamily="Consolas" Foreground="{StaticResource DimBrush}"
                               Text="14:02:11  [OK]  打开工程 教学实验_01.pht"/>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ============ 状态栏 ============ -->
        <Border Grid.Row="4" Background="{StaticResource Panel3Brush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False" Margin="12,0">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="影像" Foreground="{StaticResource DimBrush}" FontSize="11"/>
                    <TextBlock x:Name="StatusImageCount" Text="0" Foreground="{StaticResource MutBrush}" FontSize="11" Margin="5,0,0,0"/>
                    <TextBlock Text="控制点" Foreground="{StaticResource DimBrush}" FontSize="11" Margin="14,0,0,0"/>
                    <TextBlock x:Name="StatusGcpCount" Text="0" Foreground="{StaticResource MutBrush}" FontSize="11" Margin="5,0,0,0"/>
                    <TextBlock Text="像点" Foreground="{StaticResource DimBrush}" FontSize="11" Margin="14,0,0,0"/>
                    <TextBlock x:Name="StatusPointCount" Text="0" Foreground="{StaticResource MutBrush}"
                               FontSize="11" Margin="5,0,0,0"/>
                    <TextBlock Text="当前任务" Foreground="{StaticResource DimBrush}" FontSize="11" Margin="14,0,0,0"/>
                    <TextBlock x:Name="StatusTask" Text="相对定向" Foreground="{StaticResource MutBrush}"
                               FontSize="11" Margin="5,0,0,0"/>

                    <StackPanel x:Name="BusyPanel" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="20,0,0,0" Visibility="Collapsed">
                        <ProgressBar x:Name="BusyBar" Width="110" Height="5" IsIndeterminate="True"
                                     Foreground="{StaticResource AccentBrush}"
                                     Background="{StaticResource LineBrush}" BorderThickness="0"
                                     VerticalAlignment="Center"/>
                        <TextBlock x:Name="BusyText" Text="正在读取影像…" FontSize="11"
                                   Foreground="{StaticResource MutBrush}" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="光标" Foreground="{StaticResource DimBrush}" FontSize="11"/>
                    <TextBlock x:Name="StatusCursor" Text="—" Foreground="{StaticResource MutBrush}"
                               FontSize="11" FontFamily="Consolas" Margin="5,0,0,0"/>
                    <TextBlock Text="单位 mm / m / °" Foreground="{StaticResource DimBrush}"
                               FontSize="11" Margin="16,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
