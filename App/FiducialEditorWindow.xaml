<Window x:Class="Photogrammetry.App.FiducialEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="框标坐标" Width="470" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="#F4F6F8">
    <StackPanel Margin="16">
        <TextBlock FontSize="11.5" Foreground="#58636E" TextWrapping="Wrap"
                   Text="相机检校文件没提供、或者提供得不对时，在这里直接填。编号顺序由相机厂家规定，程序不替你猜。"/>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="f (mm)" FontSize="11.5"
                       Foreground="#58636E" VerticalAlignment="Center" Margin="0,0,8,4"/>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="BoxF" FontFamily="Consolas"
                     FontSize="11.5" Padding="3,2" Margin="0,0,14,4"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="x0 (mm)" FontSize="11.5"
                       Foreground="#58636E" VerticalAlignment="Center" Margin="0,0,8,4"/>
            <TextBox Grid.Row="0" Grid.Column="3" x:Name="BoxX0" FontFamily="Consolas"
                     FontSize="11.5" Padding="3,2" Margin="0,0,0,4"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="y0 (mm)" FontSize="11.5"
                       Foreground="#58636E" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="BoxY0" FontFamily="Consolas"
                     FontSize="11.5" Padding="3,2" Margin="0,0,14,0"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="方位提示来自坐标" FontSize="10.5"
                       Foreground="#8B959F" VerticalAlignment="Center" Grid.ColumnSpan="2"/>
        </Grid>

        <TextBlock Text="框标坐标（mm，以像主点为原点，y 向上）" FontSize="11.5"
                   Foreground="#58636E" Margin="0,14,0,6"/>

        <DataGrid x:Name="Grid" Height="228" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  RowHeight="24" FontFamily="Consolas" FontSize="11.5"
                  Background="White" BorderBrush="#E1E6EB">
            <DataGrid.Columns>
                <DataGridTextColumn Header="编号" Binding="{Binding Id}" Width="56"/>
                <DataGridTextColumn Header="X (mm)" Binding="{Binding X}" Width="*"/>
                <DataGridTextColumn Header="Y (mm)" Binding="{Binding Y}" Width="*"/>
                <DataGridTextColumn Header="方位" Binding="{Binding Where}" Width="86" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="添加一行" Click="Add_Click"
                    Style="{StaticResource ToolBtn}"/>
            <Button DockPanel.Dock="Left" Content="删除选中" Click="Remove_Click"
                    Style="{StaticResource ToolBtn}" Margin="6,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="确定" Click="Ok_Click"
                    Style="{StaticResource ToolBtn}" Margin="6,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="取消" Click="Cancel_Click"
                    Style="{StaticResource ToolBtn}"/>
        </DockPanel>

        <TextBlock x:Name="ErrorText" FontSize="11" Foreground="#C0392B"
                   TextWrapping="Wrap" Margin="0,8,0,0"/>
    </StackPanel>
</Window>
