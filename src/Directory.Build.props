<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NeutralLanguage>zh-Hans</NeutralLanguage>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- 本项目不引用任何外部包，关闭 NuGet 审计可避免离线环境下访问 nuget.org -->
    <NuGetAudit>false</NuGetAudit>

    <!-- 原生算法库。先构建 native/，产物随托管程序一起输出到 bin。 -->
    <NativeAlgorithmDll>$(MSBuildThisFileDirectory)..\native\build\bin\Release\photogrammetry.dll</NativeAlgorithmDll>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(NativeAlgorithmDll)')">
    <None Include="$(NativeAlgorithmDll)">
      <Link>photogrammetry.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

  <Target Name="WarnMissingNativeAlgorithmDll" BeforeTargets="Build"
          Condition="!Exists('$(NativeAlgorithmDll)')">
    <Message Importance="high"
             Text="警告：未找到 $(NativeAlgorithmDll)。先运行 cmake --build native/build --config Release，否则调用算法时会抛 DllNotFoundException。" />
  </Target>
</Project>
