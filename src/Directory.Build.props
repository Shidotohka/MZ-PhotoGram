<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NeutralLanguage>zh-Hans</NeutralLanguage>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- 本项目不引用任何外部包，关闭 NuGet 审计可避免离线环境下访问 nuget.org -->
    <NuGetAudit>false</NuGetAudit>

    <!-- 原生算法库。先构建 native/，产物随托管程序一起输出到 bin。 -->
    <NativeAlgorithmDll>$(MSBuildThisFileDirectory)..\native\build\bin\Release\photogrammetry.dll</NativeAlgorithmDll>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(NativeAlgorithmDll)')">
    <None Include="$(NativeAlgorithmDll)">
      <Link>photogrammetry.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

  <!-- 匹配模块（第二个 DLL）与 OpenCV 运行时。没装 vcpkg 时静默跳过：
       其余算法照常，只有「自动匹配」会提示 photogrammetry_cv.dll 找不到。 -->
  <PropertyGroup>
    <NativeMatchDll>$(MSBuildThisFileDirectory)..\native\build\bin\Release\photogrammetry_cv.dll</NativeMatchDll>
    <VcpkgRuntimeBin Condition="'$(VcpkgRuntimeBin)' == ''">C:\vcpkg\installed\x64-windows\bin</VcpkgRuntimeBin>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(NativeMatchDll)')">
    <None Include="$(NativeMatchDll)">
      <Link>photogrammetry_cv.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

  <ItemGroup Condition="Exists('$(VcpkgRuntimeBin)\opencv_core4.dll')">
    <None Include="$(VcpkgRuntimeBin)\opencv_*.dll;$(VcpkgRuntimeBin)\z.dll;$(VcpkgRuntimeBin)\jpeg62.dll;$(VcpkgRuntimeBin)\libpng16.dll;$(VcpkgRuntimeBin)\tiff.dll;$(VcpkgRuntimeBin)\liblzma.dll">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

  <Target Name="WarnMissingNativeAlgorithmDll" BeforeTargets="Build"
          Condition="!Exists('$(NativeAlgorithmDll)')">
    <Message Importance="high"
             Text="警告：未找到 $(NativeAlgorithmDll)。先运行 cmake --build native/build --config Release，否则调用算法时会抛 DllNotFoundException。" />
  </Target>
</Project>
