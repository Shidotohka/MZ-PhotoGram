<UserControl x:Class="Photogrammetry.App.ImageWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Photogrammetry.App"
             Background="{StaticResource WorkspaceBgBrush}">

    <Grid>
        <!-- 单图：内定向、后方交会 -->
        <Grid x:Name="SinglePanel">
            <local:ImageView x:Name="SingleView" Margin="18"/>
        </Grid>

        <!-- 双图：前方交会、相对定向 -->
        <Grid x:Name="DoublePanel" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <local:ImageView x:Name="LeftView" Grid.Column="0" Margin="18,18,9,18"/>
            <Border Grid.Column="1" Background="{StaticResource Line2Brush}"/>
            <local:ImageView x:Name="RightView" Grid.Column="2" Margin="9,18,18,18"/>
        </Grid>

        <!-- 刺点：左为控制点放大影像（对照），右为整幅航摄影像 -->
        <Grid x:Name="PickPanel" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="18,18,0,18" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource Line2Brush}" BorderThickness="1" CornerRadius="7">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Height="32" Padding="10,0"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                        <DockPanel LastChildFill="True">
                            <TextBlock x:Name="ReferenceCaption" Text="控制点放大影像" FontSize="11.5"
                                       Foreground="{StaticResource MutBrush}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Border>

                    <Grid>
                        <Image x:Name="ReferenceImage" Stretch="Uniform" Margin="8"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="Collapsed"/>
                        <TextBlock x:Name="ReferenceHint" Margin="14"
                                   Text="无放大影像"
                                   FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{StaticResource DimBrush}"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource Line2Brush}"/>
            <local:ImageView x:Name="PickView" Grid.Column="2" Margin="9,18,18,18"/>
        </Grid>

        <!-- 模型视图：绝对定向 -->
        <ContentControl x:Name="ModelPanel" Visibility="Collapsed"
                        Style="{StaticResource Viewport}"
                        Content="模型 M1 · 自由坐标系"
                        Margin="18"/>
    </Grid>
</UserControl>
