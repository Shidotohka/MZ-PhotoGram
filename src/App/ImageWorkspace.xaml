<UserControl x:Class="Photogrammetry.App.ImageWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Photogrammetry.App"
             Background="{StaticResource WorkspaceBgBrush}">

    <Grid>
        <!-- 单图：内定向、后方交会 -->
        <Grid x:Name="SinglePanel">
            <local:ImageView x:Name="SingleView" Margin="18"/>
        </Grid>

        <!-- 双图：前方交会、相对定向 -->
        <Grid x:Name="DoublePanel" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <local:ImageView x:Name="LeftView" Grid.Column="0" Margin="18,18,9,18"/>
            <Border Grid.Column="1" Background="{StaticResource Line2Brush}"/>
            <local:ImageView x:Name="RightView" Grid.Column="2" Margin="9,18,18,18"/>
        </Grid>

        <!-- 刺点：左为控制点放大影像（对照），右为整幅航摄影像 -->
        <Grid x:Name="PickPanel" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="18,18,0,18" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource Line2Brush}" BorderThickness="1" CornerRadius="7">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Height="32" Padding="10,0"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                        <DockPanel LastChildFill="True">
                            <TextBlock x:Name="ReferenceCaption" Text="控制点放大影像" FontSize="11.5"
                                       Foreground="{StaticResource MutBrush}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Border>

                    <Grid>
                        <Image x:Name="ReferenceImage" Stretch="Uniform" Margin="8"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="Collapsed"/>
                        <TextBlock x:Name="ReferenceHint" Margin="14"
                                   Text="选中一个控制点后，这里显示它的放大影像。&#x0a;&#x0a;没有放大影像也能刺点——这块只是对照。"
                                   FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{StaticResource DimBrush}"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource Line2Brush}"/>
            <local:ImageView x:Name="PickView" Grid.Column="2" Margin="9,18,18,18"/>
        </Grid>

        <!-- 模型视图：绝对定向 -->
        <ContentControl x:Name="ModelPanel" Visibility="Collapsed"
                        Style="{StaticResource Viewport}"
                        Content="模型 M1 · 自由坐标系"
                        Margin="18"/>

        <!-- 报告预览 -->
        <Grid x:Name="ReportPanel" Visibility="Collapsed">
            <Border Width="720" Background="#FFFFFF" BorderBrush="{StaticResource Line2Brush}"
                    BorderThickness="1" Margin="0,28" HorizontalAlignment="Center">
                <StackPanel Margin="40,32">
                    <TextBlock Text="摄影测量计算报告" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="教学实验_01 · 相对定向 / 0001–0002" FontSize="11"
                               Foreground="{StaticResource DimBrush}" Margin="0,6,0,0"/>
                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,14"/>

                    <TextBlock Text="一、输入数据" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"/>
                    <Border Height="1" Background="{StaticResource Panel3Brush}" Margin="0,18,0,0"/>
                    <Border Height="1" Background="{StaticResource Panel3Brush}" Margin="0,10,0,0"/>

                    <TextBlock Text="二、相对定向元素" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" Margin="0,22,0,0"/>
                    <Border Height="1" Background="{StaticResource Panel3Brush}" Margin="0,18,0,0"/>
                    <Border Height="1" Background="{StaticResource Panel3Brush}" Margin="0,10,0,0"/>
                    <Border Height="1" Background="{StaticResource Panel3Brush}" Margin="0,10,0,0"/>

                    <TextBlock Text="三、精度与诊断" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" Margin="0,22,0,0"/>
                    <Border Height="1" Background="{StaticResource Panel3Brush}" Margin="0,18,0,0"/>

                    <TextBlock Text="报告预览 · 待接入（M8）" FontSize="11"
                               Foreground="{StaticResource DimBrush}" Margin="0,26,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
