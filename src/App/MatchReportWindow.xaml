<Window x:Class="Photogrammetry.App.MatchReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="匹配质量" Height="620" Width="720"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" FontSize="12">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="SummaryText" Grid.Row="0" TextWrapping="Wrap"
                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1" Text="核线残差（mm）——匹配点偏离核线多远"
                   Foreground="{StaticResource DimBrush}" Margin="0,4,0,4"/>
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4"
                Padding="8" Margin="0,0,0,10">
            <Canvas x:Name="ResidualCanvas" ClipToBounds="True"/>
        </Border>

        <TextBlock Grid.Row="3" Text="交会角（°）——两条视线张开多大"
                   Foreground="{StaticResource DimBrush}" Margin="0,0,0,4"/>
        <Border Grid.Row="4" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4"
                Padding="8">
            <Canvas x:Name="AngleCanvas" ClipToBounds="True"/>
        </Border>
    </Grid>
</Window>
