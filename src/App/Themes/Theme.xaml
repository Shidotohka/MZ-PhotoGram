<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 浅色调色板：白底、黑字、蓝色强调 -->
    <SolidColorBrush x:Key="BgBrush" Color="#F4F6F8"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Panel2Brush" Color="#F7F9FA"/>
    <SolidColorBrush x:Key="Panel3Brush" Color="#EDF1F4"/>
    <SolidColorBrush x:Key="LineBrush" Color="#E1E6EB"/>
    <SolidColorBrush x:Key="Line2Brush" Color="#C9D2D9"/>
    <SolidColorBrush x:Key="TextBrush" Color="#16191D"/>
    <SolidColorBrush x:Key="MutBrush" Color="#58636E"/>
    <SolidColorBrush x:Key="DimBrush" Color="#8B959F"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#0F6FA8"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E7F1F8"/>
    <SolidColorBrush x:Key="OkBrush" Color="#1E8E5A"/>
    <SolidColorBrush x:Key="ErrBrush" Color="#C0392B"/>
    <SolidColorBrush x:Key="WorkspaceBgBrush" Color="#E9EEF3"/>
    <SolidColorBrush x:Key="ViewportHeaderBrush" Color="#F6F9FB"/>
    <SolidColorBrush x:Key="CrosshairBrush" Color="#B7C3CD"/>

    <LinearGradientBrush x:Key="TitleGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#F1F4F7" Offset="1"/>
    </LinearGradientBrush>

    <!-- 影像视窗底纹：浅灰网格 -->
    <DrawingBrush x:Key="ViewportGridBrush" TileMode="Tile"
                  Viewport="0,0,32,32" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <GeometryDrawing>
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <LineGeometry StartPoint="0,0" EndPoint="0,32"/>
                        <LineGeometry StartPoint="0,0" EndPoint="32,0"/>
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
                <GeometryDrawing.Pen>
                    <Pen Brush="#E6EBF0" Thickness="1"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- 下拉菜单 -->
    <Style x:Key="MenuPopup" TargetType="ContextMenu">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="MinWidth" Value="190"/>
    </Style>

    <Style x:Key="MenuItemStyle" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="10,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" ContentSource="Header"
                                              VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}"
                                       FontSize="11" FontFamily="Consolas"
                                       Foreground="{StaticResource DimBrush}"
                                       Margin="26,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 全局隐式样式：弹出菜单里的 MenuItem 统一外观（含分隔线两侧） -->
    <Style TargetType="MenuItem" BasedOn="{StaticResource MenuItemStyle}"/>

    <!-- 模块栏页签 -->
    <Style x:Key="ModuleTab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource MutBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Bg" Background="Transparent"/>
                        <Border x:Name="Bar" Height="2" Margin="10,0" VerticalAlignment="Bottom"
                                Background="Transparent" CornerRadius="1"/>
                        <ContentPresenter Margin="18,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            <Setter TargetName="Bg" Property="Background" Value="#EFF3F6"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 底部页签 -->
    <Style x:Key="BottomTab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource MutBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Bar" Height="2" VerticalAlignment="Bottom"
                                Background="Transparent"/>
                        <ContentPresenter Margin="12,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 报告窗口内的页签（TabControl）：与模块栏同一套视觉——下划线 + 强调色 -->
    <Style x:Key="ReportTabHost" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                            <TabPanel IsItemsHost="True" Margin="0,0,0,-1"/>
                        </Border>
                        <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" Margin="0,10,0,0"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ReportTabItem" TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource MutBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid Background="Transparent">
                        <Border x:Name="Bar" Height="2" Margin="12,0" VerticalAlignment="Bottom"
                                Background="Transparent" CornerRadius="1"/>
                        <ContentPresenter ContentSource="Header" Margin="14,6"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 作业方法下拉框：标题栏里选择走哪条流程 -->
    <Style x:Key="MethodCombo" TargetType="ComboBox">
        <Setter Property="Height" Value="26"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- 工具栏按钮 -->
    <Style x:Key="ToolBtn" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource MutBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#EDF1F5"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E2E8EE"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 影像视窗：外框 + 底纹 + 标题条 + 十字线 -->
    <Style x:Key="Viewport" TargetType="ContentControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border Background="#FFFFFF" BorderBrush="{StaticResource Line2Brush}"
                                BorderThickness="1" CornerRadius="4"/>
                        <Rectangle Margin="1" Fill="{StaticResource ViewportGridBrush}"/>

                        <Border Height="26" VerticalAlignment="Top" CornerRadius="3,3,0,0"
                                Background="{StaticResource ViewportHeaderBrush}"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                            <TextBlock Text="{TemplateBinding Content}" Margin="10,0"
                                       VerticalAlignment="Center" FontSize="11.5"
                                       Foreground="{StaticResource MutBrush}"/>
                        </Border>

                        <Border Width="1" Height="26" Background="{StaticResource CrosshairBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border Width="26" Height="1" Background="{StaticResource CrosshairBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <TextBlock Text="待载入" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="0,56,0,0" FontSize="12" Foreground="{StaticResource DimBrush}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 检查器标题栏上的「结果」按钮 =====
         常驻在标题右侧（不随模块面板换位置），所以带边框、小一号字。
         解算前禁用、解算后显示份数：用户不必先点开窗口才知道有没有结果。 -->
    <Style x:Key="ResultButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource MutBrush}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="9,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="4" Padding="{TemplateBinding Padding}"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource Line2Brush}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Panel2Brush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 点表 / 结果表 =====
         这套皮原来挂在主窗的 Window.Resources 里，只有主窗看得见。结果窗口单开后
         要共用同一副皮（否则同一个表格在窗口里长成另一个样子），挪到应用级。 -->

    <Style x:Key="MeasureHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource Panel3Brush}"/>
        <Setter Property="Foreground" Value="{StaticResource MutBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
    </Style>

    <Style x:Key="MeasureCellStyle" TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="MeasureGridStyle" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Panel3Brush}"/>
        <Setter Property="RowBackground" Value="{StaticResource PanelBrush}"/>
        <Setter Property="AlternatingRowBackground" Value="{StaticResource Panel2Brush}"/>
        <Setter Property="RowHeight" Value="22"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource MeasureHeaderStyle}"/>
        <Setter Property="CellStyle" Value="{StaticResource MeasureCellStyle}"/>
    </Style>

    <!-- 结果表的两张表：与点表共用一副皮，只多两样本事——
         ① 行可按数据染成警示色（残差偏大的那行），所以单元格不能自己钉死前景色；
         ② 残差表的列由代码按模块生成（内定向列框标、后方交会列控制点、相对定向列同名点）。 -->
    <Style x:Key="ResultCellStyle" TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ResultRowStyle" TargetType="DataGridRow">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Warn}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource ErrBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ResultGridStyle" TargetType="DataGrid"
           BasedOn="{StaticResource MeasureGridStyle}">
        <Setter Property="CellStyle" Value="{StaticResource ResultCellStyle}"/>
        <Setter Property="RowStyle" Value="{StaticResource ResultRowStyle}"/>
    </Style>

</ResourceDictionary>
