<?xml version="1.0" encoding="utf-8"?>
<!--
  第三方包只有一个：HelixToolkit.Wpf（「匹配质量」窗口的点云三维视图，见 ADR-23）。

  这份文件原来只有一个 <clear /> —— 当时仓库零 NuGet 依赖，清空包源可以让 restore
  完全离线、绝不在构建时去连网。代价是：一旦真要装包，NuGet 就只剩 SDK 自带的
  library-packs 一个源，于是 `dotnet add package` 报 NU1101「找不到包」，后面还会跟一条
  「与所有框架不兼容」——那不是框架问题，是压根没找到包。

  现在显式列出 nuget.org，而不是依赖用户级配置：restore 走哪几个源应该跟着仓库走，
  否则换台机器结果就不一样。

  只有「包不在全局缓存里」时才需要网络；包进过一次 %USERPROFILE%\.nuget\packages
  之后，restore 仍然可以离线完成。彻底无网的演示机就手动拷 .nupkg 进来见下。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!--
    无网机器的后路：把 .nupkg 丢进仓库根的 local-packages 目录（不入库），
    上面那行注释掉的 <add> 就变成一个本地源，配合 dotnet add 的 source 参数使用。
  -->
</configuration>
